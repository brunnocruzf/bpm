# BPM TMSA API — desenvolvimento local fora de containers.
# Infra auxiliar: docker compose -f deploy/docker/docker-compose.yml -f deploy/docker/docker-compose.dev.yml up -d postgres flowable-rest storage mailpit
# Nunca versione o .env real. Valores abaixo são exemplos.
APP_NAME="BPM TMSA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL publicado em 127.0.0.1:55432 pelo docker-compose.dev.yml
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=bpm_app
DB_USERNAME=bpm_app
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=bpm@tmsa.local

# Autenticação: dev (usuários fictícios; PROIBIDO em produção) | entra
BPM_AUTH_DRIVER=dev
BPM_ENTRA_TENANT_ID=
BPM_ENTRA_AUDIENCE=api://bpm-tmsa-api
BPM_ENTRA_REQUIRED_SCOPE=access_as_user
BPM_ENTRA_AREA_CLAIM=department

# Flowable REST (rede interna; publicado em 127.0.0.1:8090 apenas pelo override de dev)
FLOWABLE_REST_URL=http://127.0.0.1:8090/flowable-rest
FLOWABLE_REST_USER=bpm-engine-client
FLOWABLE_REST_PASSWORD=

# Anexos: attachments_local (disco privado) | attachments_s3 (RustFS/storage corporativo)
BPM_ATTACHMENTS_DISK=attachments_local
BPM_S3_ENDPOINT=http://127.0.0.1:9100
BPM_S3_KEY=
BPM_S3_SECRET=
BPM_S3_BUCKET=bpm-attachments
# Emulador do Azure Blob (Azurite) para testar Configurações → Armazenamento de anexos; formato http://host:10000/{conta}. Proibido em produção.
# BPM_AZURITE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1

# AX 2012 R3: MOCK até receber contratos (REST_FACADE | AIF_WCF | SQL_READONLY_VIEW)
BPM_AX_TPR_TRANSPORT=MOCK
BPM_AX_ITEM_TRANSPORT=MOCK
BPM_AX_PO_TRANSPORT=MOCK
BPM_AX_SUPPLIER_TRANSPORT=MOCK
BPM_AX_TRANSFER_TRANSPORT=MOCK

BPM_BUSINESS_TIMEZONE=America/Sao_Paulo
BPM_SEQUENCE_YEAR_FORMAT=yy
BPM_REQUIRE_DISTINCT_PUBLISHER=false

# Cofre de segredos das integrações (Entra/Graph, SMTP, M365): chave dedicada de 32 bytes em base64.
# Gere com: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"  (em Compose/produção use BPM_SECRETS_KEY_FILE)
BPM_SECRETS_KEY=
BPM_SECRETS_DIR=
# Relays SMTP internos permitidos (exceção à política anti-SSRF)
BPM_MAIL_PRIVATE_RELAY_HOSTS=
BPM_MAILPIT_HOST=127.0.0.1
BPM_MAILPIT_PORT=1025

# Relatórios: renderer nativo; Carbone opcional (BPM_CARBONE_ENABLED=true + serviço carbone; token em BPM_CARBONE_TOKEN_FILE ou, só em dev, BPM_CARBONE_TOKEN)
BPM_REPORTS_DISK=attachments_local
BPM_CARBONE_ENABLED=false
BPM_CARBONE_URL=http://127.0.0.1:4000

# Auditoria
BPM_AUDIT_CAPTURE_IP=true
BPM_AUDIT_CAPTURE_USER_AGENT=false
