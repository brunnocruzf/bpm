# Build de produção: Microsoft Entra ID (MSAL, Authorization Code + PKCE).
# Valores são identificadores públicos (não segredos) e devem vir do pipeline por ambiente.
VITE_API_BASE_URL=/api/v1
VITE_AUTH_MODE=entra
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://bpm-tmsa-api/access_as_user
VITE_ENV_LABEL=Produção
