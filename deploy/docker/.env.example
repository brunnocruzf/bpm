# Copie para .env e substitua TODOS os valores. Nunca versione o .env.
# Gere APP_KEY com: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:TROQUE_POR_UMA_CHAVE_DE_32_BYTES_EM_BASE64=
APP_ENV=local
PUBLIC_URL=http://localhost:8080
BPM_HTTP_BIND=127.0.0.1
BPM_HTTP_PORT=8080

POSTGRES_SUPERUSER_PASSWORD=troque-superuser
BPM_APP_DB_PASSWORD=troque-app
FLOWABLE_DB_PASSWORD=troque-flowable

# Credencial técnica Laravel -> Flowable REST (rede interna)
FLOWABLE_REST_USER=bpm-engine-client
FLOWABLE_REST_PASSWORD=troque-engine

# Storage S3-compatível (RustFS em dev/POC)
STORAGE_ACCESS_KEY=bpmstorage
STORAGE_SECRET_KEY=troque-storage-secret

# Login (ver .claude/login/INSTRUCOES_DE_LOGIN.md e ADR-0015). O botão Microsoft funciona sempre que o Entra
# estiver configurado (Configurações → Entra ID ou BPM_ENTRA_*). dev = habilita também o acesso de
# VISITANTE (usuários fictícios; somente dev/POC — a aplicação recusa iniciar em produção) | entra = só Entra.
BPM_AUTH_DRIVER=dev
# Link "visitante" para um ambiente de demonstração SEPARADO (use em produção, onde o visitante local é proibido)
BPM_DEMO_URL=
# SuperAdmin (usuário e senha, acesso de emergência). Senha só por: php artisan bpm:superadmin set-password
# Em produção exige BPM_SUPERADMIN_ALLOWED_IPS (IPs/CIDRs separados por vírgula).
BPM_SUPERADMIN_LOGIN_ENABLED=true
BPM_SUPERADMIN_ALLOWED_IPS=
WEB_BUILD_MODE=docker-dev
SEED_ON_START=true

# Entra ID pelo ambiente (alternativa à configuração ativada em Configurações → Entra ID)
BPM_ENTRA_TENANT_ID=
BPM_ENTRA_AUDIENCE=api://bpm-tmsa-api

# Integrações REST (Administração → Integrações e entregas). Hosts que resolvem para a rede interna
# (ex.: apidax.tmsa.ind.br → 10.x) e, em produção, TODOS os hosts precisam ser declarados aqui (vírgula).
BPM_INTEGRATION_ALLOWED_HOSTS=
# Emulador do Azure Blob (perfil dev; serviço `azurite`). Deixe vazio fora de desenvolvimento.
# BPM_AZURITE_BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1

# Antivírus opcional (clamd)
BPM_CLAMAV_HOST=

# Perfis do Compose: dev (Mailpit) · test · carbone (somente após aprovação da licença)
COMPOSE_PROFILES=dev
MAILPIT_UI_PORT=8025

# Relays SMTP internos permitidos (exceção da plataforma à política anti-SSRF; vazio = nenhum)
BPM_MAIL_PRIVATE_RELAY_HOSTS=

# Carbone (relatórios): false até aprovação jurídica/segurança. Token service-to-service via Docker secret.
BPM_CARBONE_ENABLED=false
BPM_CARBONE_TOKEN_FILE=

# A chave do cofre de segredos NÃO fica aqui: gere ./secrets/bpm_secrets_key (sh secrets/generate.sh).
