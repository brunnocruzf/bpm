# Instância da organização IMS (uma stack por organização; ver ADR-0019).
# Copie para .env.ims e substitua TODOS os valores (nunca reaproveite senhas/chaves da TMSA). Nunca versione o .env.ims.
#   sh secrets/generate.sh ims                               # chave do cofre em secrets/ims/
#   ./orgs.sh up ims    (= docker compose -p bpm-ims --env-file .env.ims up -d)
COMPOSE_PROJECT_NAME=bpm-ims

# Organização (auditoria, textos de e-mail, identidade visual padrão)
BPM_ORGANIZATION_KEY=ims
BPM_ORGANIZATION_NAME=IMS
BPM_APP_NAME=BPM IMS
MAIL_FROM_ADDRESS=bpm@ims.local

# Gere APP_KEY com: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:TROQUE_POR_UMA_CHAVE_DE_32_BYTES_EM_BASE64=
APP_ENV=local
PUBLIC_URL=http://localhost:8089
BPM_HTTP_BIND=127.0.0.1
BPM_HTTP_PORT=8089

POSTGRES_SUPERUSER_PASSWORD=troque-superuser
BPM_APP_DB_PASSWORD=troque-app
FLOWABLE_DB_PASSWORD=troque-flowable

FLOWABLE_REST_USER=bpm-engine-client
FLOWABLE_REST_PASSWORD=troque-engine

STORAGE_ACCESS_KEY=bpmstorage
STORAGE_SECRET_KEY=troque-storage-secret

# Cofre de segredos desta organização (gerado por: sh secrets/generate.sh ims)
BPM_SECRETS_KEY_PATH=./secrets/ims/bpm_secrets_key

# Login: o primeiro administrador entra pelo SuperAdmin (php artisan bpm:superadmin set-password) e
# configura Entra ID, e-mail, identidade visual e integrações pela tela.
BPM_AUTH_DRIVER=dev
BPM_DEMO_URL=
BPM_SUPERADMIN_LOGIN_ENABLED=true
BPM_SUPERADMIN_ALLOWED_IPS=
WEB_BUILD_MODE=docker-dev
# Fora da TMSA o seed não cria raias, PO 159 nem fluxos de demonstração (só modelos de relatório e, fora de produção, usuários de dev)
SEED_ON_START=true
# Só no primeiro "up" desta organização (roda migrate + bpm:storage-init, que cria o bucket de anexos,
# + o seed acima). Sem isto o bucket de anexos/fotos NUNCA é criado e upload/leitura de arquivos vira 500.
# Depois de criado, volte para "false" para não rodar o seed em todo restart/deploy.
RUN_MIGRATIONS=true

BPM_ENTRA_TENANT_ID=
BPM_ENTRA_AUDIENCE=

# Hosts liberados para as integrações desta instância (ex.: API do AX; o DataAreaId da IMS vai como constante no catálogo)
BPM_INTEGRATION_ALLOWED_HOSTS=

BPM_CLAMAV_HOST=

# Portas diferentes da TMSA para as duas stacks rodarem no mesmo host
COMPOSE_PROFILES=dev
MAILPIT_UI_PORT=8026
DEV_PG_PORT=55433
DEV_FLOWABLE_PORT=8091
DEV_S3_PORT=9101
DEV_AZURITE_PORT=10001
DEV_SMTP_PORT=1026

BPM_MAIL_PRIVATE_RELAY_HOSTS=

BPM_CARBONE_ENABLED=false
BPM_CARBONE_TOKEN_FILE=
BPM_CARBONE_TOKEN=
